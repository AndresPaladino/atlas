# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude worktrees (heavy, machine-specific)
.claude/worktrees/

# Flujo de sync personal del autor (remotes privados, cherry-pick) — no es
# onboarding; no se distribuye al template público.
.claude/WORKFLOW.md
.claude/commands/autopush.md

# Local Claude settings (contain absolute paths)
.claude/settings.local.json

# Editor
.vscode/
*.swp
*.swo

# Obsidian — el vault es wiki/. Versionar config estable (filtros/tema),
# ignorar workspace.json (estado de UI, se reescribe con cada movimiento).
# La raíz NO es vault: si Obsidian recrea /.obsidian, ignorarlo entero.
/.obsidian/
wiki/.obsidian/*
!wiki/.obsidian/graph.json
!wiki/.obsidian/plugins/
wiki/.obsidian/plugins/*
!wiki/.obsidian/plugins/appearance.json
obsidian-plugin/

# Raw sources — fuentes binarias / pesadas, no van al repo
raw/**/*.pdf
raw/**/*.epub
raw/**/*.mp4
raw/**/*.mov
raw/**/*.png
raw/**/*.jpg
raw/**/*.jpeg

# Extracción local (atlas-local): el .md y el manifest SÍ se versionan (texto,
# compartibles entre máquinas); las imágenes que extrae marker quedan locales.
!raw/**/*.md
!raw/.atlas-extract.json

# Caché local de modelos ML (marker/HuggingFace) — pesados, no van al repo.
.atlas-cache/

# Estado de sesión / firewall (efímero, por máquina).
.atlas/
